#!/usr/bin/env python3
"""filesort - automatically sort files into subdirectories by various strategies.

Usage:
    filesort <target_dir> [OPTIONS]
    filesort <target_dir> --undo
    filesort --list presets|type-groups|all
    filesort presets list
    filesort presets remove NAME
    filesort groups list
    filesort groups set NAME=ext1,ext2
    filesort groups remove NAME
    filesort completion SHELL
    filesort completion install [SHELL]
    filesort --list-preset
    filesort --remove-preset NAME
    filesort --set-type-group NAME=ext1,ext2
"""

import argparse
import os
import sys

from organizer.core import organize
from organizer.presets import (
    PresetError,
    list_presets,
    load_preset,
    load_type_groups,
    remove_preset,
    remove_type_group,
    save_preset,
    save_type_group,
)
from organizer.undo import undo_last


LIST_TARGET_ALIASES = {
    "all": "all",
    "preset": "presets",
    "presets": "presets",
    "type-group": "type-groups",
    "type-groups": "type-groups",
    "group": "type-groups",
    "groups": "type-groups",
}

COMPLETION_SHELLS = {"bash", "powershell", "zsh"}
COMPLETION_BLOCK_START = "# >>> filesort completion >>>"
COMPLETION_BLOCK_END = "# <<< filesort completion <<<"


def _expand_management_argv(argv):
    if not argv:
        return argv

    command = argv[0]
    rest = argv[1:]

    if command == "completion":
        if rest and rest[0] == "install":
            return ["--install-completion"] + rest[1:]
        return ["--completion"] + rest

    if command in ("preset", "presets"):
        if not rest or rest[0] == "list":
            return ["--list", "presets"] + rest[1:]
        if rest[0] == "remove":
            expanded = []
            for name in rest[1:]:
                expanded.extend(["--remove-preset", name])
            return expanded
        return argv

    if command in ("group", "groups", "type-group", "type-groups"):
        if not rest or rest[0] == "list":
            return ["--list", "type-groups"] + rest[1:]
        if rest[0] == "set":
            expanded = []
            for spec in rest[1:]:
                expanded.extend(["--set-type-group", spec])
            return expanded
        if rest[0] == "remove":
            expanded = []
            for name in rest[1:]:
                expanded.extend(["--remove-type-group", name])
            return expanded
        return argv

    return argv


def _parse_type_group_spec(spec):
    if "=" not in spec:
        raise PresetError(
            "Type-group definitions must look like 'images=jpg,jpeg,png'."
        )

    group_name, raw_extensions = spec.split("=", 1)
    extensions = [part.strip() for part in raw_extensions.split(",") if part.strip()]
    if not extensions:
        raise PresetError(
            f"Type group '{group_name.strip() or group_name}' must include at least one extension."
        )
    return group_name, extensions


def _format_strategy_args(strategy_args):
    if not strategy_args:
        return ""
    parts = [f"{key}={strategy_args[key]!r}" for key in sorted(strategy_args)]
    return f" ({', '.join(parts)})"


def _print_presets():
    presets = list_presets()
    if not presets:
        print("No presets configured.")
        return

    print("Configured presets:")
    for name in sorted(presets):
        preset = presets[name]
        print(
            f"  {name}: {preset['strategy']}"
            f"{_format_strategy_args(preset['strategy_args'])}"
        )


def _print_type_groups():
    type_groups = load_type_groups()
    if not type_groups:
        print("No type groups configured.")
        return

    print("Configured type groups:")
    for name in sorted(type_groups):
        print(f"  {name}={','.join(type_groups[name])}")


def _has_organization_options(args):
    return (
        args.undo
        or args.execute
        or args.save_preset
        or args.preset
        or args.by_type
        or args.by_pattern
        or args.by_date is not None
        or args.no_type_groups
    )


def _handle_list_command(args, parser):
    if not args.list_config:
        return False

    if args.target is not None:
        parser.error("List commands do not take a target directory.")

    if (
        _has_organization_options(args)
        or args.list_preset
        or args.remove_preset
        or args.set_type_group
        or args.remove_type_group
        or args.list_type_groups
        or args.completion
        or args.install_completion
    ):
        parser.error("List commands cannot be combined with other modes.")

    target = LIST_TARGET_ALIASES.get(args.list_config)
    if target is None:
        valid = ", ".join(sorted(LIST_TARGET_ALIASES))
        parser.error(f"--list must be one of: {valid}.")

    try:
        if target in ("presets", "all"):
            _print_presets()
        if target == "all":
            print()
        if target in ("type-groups", "all"):
            _print_type_groups()
        return True
    except PresetError as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(2)


def _handle_preset_commands(args, parser):
    modes = sum(
        1
        for active in (
            args.list_preset,
            bool(args.remove_preset),
        )
        if active
    )
    if modes == 0:
        return False

    if modes > 1:
        parser.error("Choose only one preset management mode: list or remove.")

    if args.target is not None:
        parser.error("Preset management commands do not take a target directory.")

    if (
        _has_organization_options(args)
        or args.list_config
        or args.completion
        or args.install_completion
        or args.set_type_group
        or args.remove_type_group
        or args.list_type_groups
    ):
        parser.error(
            "Preset management commands cannot be combined with organization options."
        )

    try:
        if args.remove_preset:
            for name in args.remove_preset:
                path = remove_preset(name)
                print(f"Removed preset '{name}' from '{path}'.")
            return True

        _print_presets()
        return True
    except PresetError as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(2)


def _handle_type_group_commands(args, parser):
    modes = sum(
        1
        for active in (
            bool(args.set_type_group),
            bool(args.remove_type_group),
            args.list_type_groups,
        )
        if active
    )
    if modes == 0:
        return False

    if modes > 1:
        parser.error(
            "Choose only one type-group management mode: set, remove, or list."
        )

    if args.target is not None:
        parser.error("Type-group management commands do not take a target directory.")

    if (
        _has_organization_options(args)
        or args.list_config
        or args.completion
        or args.install_completion
        or args.list_preset
        or args.remove_preset
    ):
        parser.error(
            "Type-group management commands cannot be combined with organization options."
        )

    try:
        if args.set_type_group:
            for spec in args.set_type_group:
                name, extensions = _parse_type_group_spec(spec)
                path, existed = save_type_group(name, extensions)
                action = "Updated" if existed else "Saved"
                print(
                    f"{action} type group '{name.strip()}' in '{path}' "
                    f"with extensions: {', '.join(extensions)}."
                )
            return True

        if args.remove_type_group:
            for name in args.remove_type_group:
                path = remove_type_group(name)
                print(f"Removed type group '{name}' from '{path}'.")
            return True

        _print_type_groups()
        return True
    except PresetError as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(2)


def _completion_options():
    return [
        "-h",
        "--help",
        "-d",
        "--by-date",
        "-t",
        "--by-type",
        "-p",
        "--by-pattern",
        "--preset",
        "-e",
        "--execute",
        "--save-preset",
        "--list",
        "--no-type-groups",
        "-u",
        "--undo",
    ]


def _completion_script(shell):
    options = " ".join(_completion_options())
    list_targets = " ".join(sorted(LIST_TARGET_ALIASES))
    shells = " ".join(sorted(COMPLETION_SHELLS))
    commands = "completion group groups preset presets type-group type-groups"
    completion_actions = "install bash powershell zsh"

    if shell == "bash":
        return f"""# bash completion for filesort
_filesort_completion() {{
  local cur prev words cword
  COMPREPLY=()
  cur="${{COMP_WORDS[COMP_CWORD]}}"
  prev="${{COMP_WORDS[COMP_CWORD-1]}}"

  case "$prev" in
    --list)
      COMPREPLY=( $(compgen -W "{list_targets}" -- "$cur") )
      return 0
      ;;
    --completion|install)
      COMPREPLY=( $(compgen -W "{shells}" -- "$cur") )
      return 0
      ;;
    completion)
      COMPREPLY=( $(compgen -W "{completion_actions}" -- "$cur") )
      return 0
      ;;
    preset|presets)
      COMPREPLY=( $(compgen -W "list remove" -- "$cur") )
      return 0
      ;;
    group|groups|type-group|type-groups)
      COMPREPLY=( $(compgen -W "list set remove" -- "$cur") )
      return 0
      ;;
  esac

  if [[ "$cur" == -* ]]; then
    COMPREPLY=( $(compgen -W "{options}" -- "$cur") )
  else
    COMPREPLY=( $(compgen -W "{commands}" -- "$cur") )
  fi
}}
complete -F _filesort_completion filesort
"""

    if shell == "zsh":
        return f"""# zsh completion for filesort
#compdef filesort

_filesort() {{
  local -a options commands list_targets shells preset_actions group_actions
  options=({_zsh_words(_completion_options())})
  commands=({_zsh_words(commands.split())})
  list_targets=({_zsh_words(sorted(LIST_TARGET_ALIASES))})
  shells=({_zsh_words(sorted(COMPLETION_SHELLS))})
  preset_actions=(list remove)
  group_actions=(list set remove)
  completion_actions=(install bash powershell zsh)

  case $words[2] in
    preset|presets)
      _describe 'preset action' preset_actions
      return
      ;;
    group|groups|type-group|type-groups)
      _describe 'group action' group_actions
      return
      ;;
    completion)
      if [[ $words[3] == "install" ]]; then
        _describe 'shell' shells
      else
        _describe 'completion action' completion_actions
      fi
      return
      ;;
    install)
      _describe 'shell' shells
      return
      ;;
  esac

  if [[ $words[CURRENT-1] == "--list" ]]; then
    _describe 'list target' list_targets
    return
  fi

  if [[ $PREFIX == -* ]]; then
    _describe 'option' options
  else
    _describe 'command' commands
    _files
  fi
}}

_filesort "$@"
"""

    return f"""# PowerShell completion for filesort
Register-ArgumentCompleter -Native -CommandName filesort -ScriptBlock {{
  param($wordToComplete, $commandAst, $cursorPosition)

  $options = @('{ "', '".join(_completion_options()) }')
  $commands = @('{ "', '".join(commands.split()) }')
  $completionActions = @('{ "', '".join(completion_actions.split()) }')
  $listTargets = @('{ "', '".join(sorted(LIST_TARGET_ALIASES)) }')
  $shells = @('{ "', '".join(sorted(COMPLETION_SHELLS)) }')
  $words = $commandAst.CommandElements | ForEach-Object {{ $_.ToString() }}
  $previous = if ($words.Count -gt 1) {{ $words[$words.Count - 2] }} else {{ "" }}
  $first = if ($words.Count -gt 1) {{ $words[1] }} else {{ "" }}

  if ($previous -eq "--list") {{
    $listTargets | Where-Object {{ $_ -like "$wordToComplete*" }} | ForEach-Object {{
      [System.Management.Automation.CompletionResult]::new($_, $_, "ParameterValue", $_)
    }}
    return
  }}

  if ($previous -in @("--completion", "--install-completion", "install")) {{
    $shells | Where-Object {{ $_ -like "$wordToComplete*" }} | ForEach-Object {{
      [System.Management.Automation.CompletionResult]::new($_, $_, "ParameterValue", $_)
    }}
    return
  }}

  if ($previous -eq "completion") {{
    $completionActions | Where-Object {{ $_ -like "$wordToComplete*" }} | ForEach-Object {{
      [System.Management.Automation.CompletionResult]::new($_, $_, "ParameterValue", $_)
    }}
    return
  }}

  if ($first -in @("preset", "presets")) {{
    @("list", "remove") | Where-Object {{ $_ -like "$wordToComplete*" }} | ForEach-Object {{
      [System.Management.Automation.CompletionResult]::new($_, $_, "ParameterValue", $_)
    }}
    return
  }}

  if ($first -in @("group", "groups", "type-group", "type-groups")) {{
    @("list", "set", "remove") | Where-Object {{ $_ -like "$wordToComplete*" }} | ForEach-Object {{
      [System.Management.Automation.CompletionResult]::new($_, $_, "ParameterValue", $_)
    }}
    return
  }}

  $candidates = if ($wordToComplete -like "-*") {{ $options }} else {{ $commands + $options }}
  $candidates | Where-Object {{ $_ -like "$wordToComplete*" }} | ForEach-Object {{
    [System.Management.Automation.CompletionResult]::new($_, $_, "ParameterName", $_)
  }}
}}
"""


def _zsh_words(words):
    return " ".join(f"'{word}'" for word in words)


def _completion_home():
    override = os.getenv("FILESORT_COMPLETION_HOME")
    if override:
        return os.path.abspath(os.path.expanduser(override))
    return os.path.expanduser("~")


def _detect_completion_shell():
    shell = os.getenv("SHELL", "")
    shell_name = os.path.basename(shell).lower()
    if shell_name in COMPLETION_SHELLS:
        return shell_name
    if os.name == "nt":
        return "powershell"
    raise PresetError(
        "Could not detect your shell. Use: filesort completion install bash|zsh|powershell."
    )


def _write_text(path, content):
    directory = os.path.dirname(path)
    if directory:
        os.makedirs(directory, exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.write(content)


def _update_managed_block(path, block):
    if os.path.exists(path):
        with open(path, "r", encoding="utf-8") as f:
            content = f.read()
    else:
        content = ""

    start = content.find(COMPLETION_BLOCK_START)
    end = content.find(COMPLETION_BLOCK_END)
    if start != -1 and end != -1 and end > start:
        end += len(COMPLETION_BLOCK_END)
        content = content[:start].rstrip() + "\n\n" + block + content[end:]
    else:
        separator = "\n\n" if content.strip() else ""
        content = content.rstrip() + separator + block + "\n"

    _write_text(path, content)


def _install_bash_completion(home):
    completion_path = os.path.join(
        home,
        ".local",
        "share",
        "bash-completion",
        "completions",
        "filesort",
    )
    _write_text(completion_path, _completion_script("bash"))

    bashrc_path = os.path.join(home, ".bashrc")
    block = f"""{COMPLETION_BLOCK_START}
_filesort_completion_file="$HOME/.local/share/bash-completion/completions/filesort"
if [ -f "$_filesort_completion_file" ]; then
  . "$_filesort_completion_file"
fi
unset _filesort_completion_file
{COMPLETION_BLOCK_END}"""
    _update_managed_block(bashrc_path, block)

    return (
        f"Installed bash completion to '{completion_path}'.\n"
        f"Updated '{bashrc_path}'. Open a new terminal to use Tab completion.\n"
        "For this terminal only, run: source ~/.bashrc"
    )


def _install_zsh_completion(home):
    completion_dir = os.path.join(home, ".zfunc")
    completion_path = os.path.join(completion_dir, "_filesort")
    _write_text(completion_path, _completion_script("zsh"))

    zshrc_path = os.path.join(home, ".zshrc")
    block = f"""{COMPLETION_BLOCK_START}
fpath=("$HOME/.zfunc" $fpath)
autoload -Uz compinit
compinit
{COMPLETION_BLOCK_END}"""
    _update_managed_block(zshrc_path, block)

    return (
        f"Installed zsh completion to '{completion_path}'.\n"
        f"Updated '{zshrc_path}'. Open a new terminal to use Tab completion.\n"
        "For this terminal only, run: source ~/.zshrc"
    )


def _powershell_profile_path(home):
    if os.name == "nt":
        return os.path.join(
            home,
            "Documents",
            "PowerShell",
            "Microsoft.PowerShell_profile.ps1",
        )
    return os.path.join(
        home,
        ".config",
        "powershell",
        "Microsoft.PowerShell_profile.ps1",
    )


def _install_powershell_completion(home):
    completion_path = os.path.join(home, ".filesort", "completion", "filesort.ps1")
    _write_text(completion_path, _completion_script("powershell"))

    profile_path = _powershell_profile_path(home)
    block = f"""{COMPLETION_BLOCK_START}
. "$HOME/.filesort/completion/filesort.ps1"
{COMPLETION_BLOCK_END}"""
    _update_managed_block(profile_path, block)

    return (
        f"Installed PowerShell completion to '{completion_path}'.\n"
        f"Updated '{profile_path}'. Open a new terminal to use Tab completion.\n"
        "For this terminal only, run: . $HOME/.filesort/completion/filesort.ps1"
    )


def _install_completion(shell):
    selected_shell = shell.lower() if shell else _detect_completion_shell()
    if selected_shell not in COMPLETION_SHELLS:
        raise PresetError(
            "Completion install shell must be one of: "
            + ", ".join(sorted(COMPLETION_SHELLS))
            + "."
        )

    home = _completion_home()
    installers = {
        "bash": _install_bash_completion,
        "powershell": _install_powershell_completion,
        "zsh": _install_zsh_completion,
    }
    return installers[selected_shell](home)


def _handle_completion_command(args, parser):
    if not args.completion and not args.install_completion:
        return False

    if args.target is not None:
        parser.error("Completion commands do not take a target directory.")

    if (
        _has_organization_options(args)
        or args.list_config
        or args.list_preset
        or args.remove_preset
        or args.set_type_group
        or args.remove_type_group
        or args.list_type_groups
    ):
        parser.error("Completion commands cannot be combined with other modes.")

    if args.completion and args.install_completion:
        parser.error("Choose either completion script output or completion install.")

    if args.install_completion:
        shell = None if args.install_completion == "auto" else args.install_completion
        try:
            print(_install_completion(shell))
            return True
        except PresetError as e:
            print(f"Error: {e}", file=sys.stderr)
            sys.exit(2)

    shell = args.completion.lower()
    if shell not in COMPLETION_SHELLS:
        parser.error(
            "--completion must be one of: "
            + ", ".join(sorted(COMPLETION_SHELLS))
            + "."
        )

    print(_completion_script(shell), end="")
    return True


def _resolve_strategy(args):
    by_type = getattr(args, "by_type", False)
    by_pattern = getattr(args, "by_pattern", None)
    by_date = getattr(args, "by_date", None)
    preset_name = getattr(args, "preset", None)

    if preset_name:
        try:
            return load_preset(preset_name)
        except PresetError as e:
            print(f"Error: {e}", file=sys.stderr)
            sys.exit(2)

    if by_type:
        return "by_type", {}
    if by_pattern:
        return "by_pattern", {"pattern": by_pattern}
    if by_date is not None:
        return "by_date", {"fmt": by_date}

    return "by_type", {}


def _build_runtime_strategy_args(strategy_name, strategy_args, use_type_groups):
    runtime_args = dict(strategy_args)
    if (
        strategy_name == "by_type"
        and use_type_groups
        and "type_groups" not in runtime_args
    ):
        try:
            type_groups = load_type_groups()
        except PresetError as e:
            print(f"Error: {e}", file=sys.stderr)
            sys.exit(2)
        if type_groups:
            runtime_args["type_groups"] = type_groups
    return runtime_args


def build_parser():
    parser = argparse.ArgumentParser(
        prog="filesort",
        description="Sort files in the selected directory into subdirectories by classification strategy.",
        epilog=(
            "Preview is shown by default; confirm with 'y' or use --execute to skip. "
            "Config shortcuts: filesort presets list, filesort groups set images=jpg,png. "
            "Completion setup: filesort completion install."
        ),
    )
    parser.add_argument(
        "target",
        nargs="?",
        help="Target directory containing files to organize. Only top-level files are processed.",
    )

    strategy_group = parser.add_mutually_exclusive_group()
    strategy_group.add_argument(
        "-d", "--by-date",
        nargs="?", const="%Y-%m", metavar="FORMAT",
        help="Group by modification date (default format: %%Y-%%m). Category names are sanitized to stay single-level.",
    )
    strategy_group.add_argument(
        "-t", "--by-type",
        action="store_true",
        help="Group by file extension, applying saved type groups by default.",
    )
    strategy_group.add_argument(
        "-p", "--by-pattern",
        metavar="PATTERN",
        help="Group by regex pattern; capture group 1 becomes the category name after sanitization.",
    )
    strategy_group.add_argument(
        "--preset",
        metavar="NAME",
        help="Load a saved preset for the selected directory.",
    )

    parser.add_argument(
        "-e", "--execute",
        action="store_true",
        help="Execute directly without preview/confirmation.",
    )
    parser.add_argument(
        "--save-preset",
        metavar="NAME",
        help="Save the current strategy as a reusable preset.",
    )
    parser.add_argument(
        "--list",
        dest="list_config",
        metavar="WHAT",
        help="List saved config: presets, type-groups, or all.",
    )
    parser.add_argument(
        "--list-preset",
        "--list-presets",
        dest="list_preset",
        action="store_true",
        help=argparse.SUPPRESS,
    )
    parser.add_argument(
        "--remove-preset",
        metavar="NAME",
        action="append",
        help=argparse.SUPPRESS,
    )
    parser.add_argument(
        "--set-type-group",
        metavar="NAME=ext1,ext2",
        action="append",
        help=argparse.SUPPRESS,
    )
    parser.add_argument(
        "--remove-type-group",
        metavar="NAME",
        action="append",
        help=argparse.SUPPRESS,
    )
    parser.add_argument(
        "--list-type-groups",
        action="store_true",
        help=argparse.SUPPRESS,
    )
    parser.add_argument(
        "--no-type-groups",
        action="store_true",
        help="Temporarily ignore saved global type groups for this run.",
    )
    parser.add_argument(
        "-u", "--undo",
        action="store_true",
        help="Rollback the last organization operation.",
    )
    parser.add_argument(
        "--completion",
        metavar="SHELL",
        help=argparse.SUPPRESS,
    )
    parser.add_argument(
        "--install-completion",
        nargs="?",
        const="auto",
        metavar="SHELL",
        help=argparse.SUPPRESS,
    )
    return parser


def main(argv=None):
    parser = build_parser()
    argv = _expand_management_argv(sys.argv[1:] if argv is None else list(argv))
    args = parser.parse_args(argv)

    if _handle_completion_command(args, parser):
        return

    if _handle_list_command(args, parser):
        return

    if _handle_type_group_commands(args, parser):
        return

    if _handle_preset_commands(args, parser):
        return

    if not args.target:
        parser.error(
            "target is required unless using a preset or type-group management command."
        )

    if args.undo and (
        args.preset
        or args.save_preset
        or args.list_preset
        or args.remove_preset
        or args.no_type_groups
    ):
        parser.error("--undo cannot be combined with preset or type-group runtime options.")

    if args.preset and args.save_preset:
        parser.error("--preset cannot be combined with --save-preset.")

    if args.undo:
        undo_last(args.target)
        return

    strategy_name, strategy_args = _resolve_strategy(args)

    if args.save_preset:
        try:
            path, existed = save_preset(args.save_preset, strategy_name, strategy_args)
        except PresetError as e:
            print(f"Error: {e}", file=sys.stderr)
            sys.exit(2)

        action = "Updated" if existed else "Saved"
        print(f"{action} preset '{args.save_preset}' in '{path}'.")

    runtime_strategy_args = _build_runtime_strategy_args(
        strategy_name,
        strategy_args,
        use_type_groups=not args.no_type_groups,
    )

    organize(
        target_dir=args.target,
        strategy_name=strategy_name,
        strategy_args=runtime_strategy_args,
        execute=args.execute,
    )


if __name__ == "__main__":
    main()
